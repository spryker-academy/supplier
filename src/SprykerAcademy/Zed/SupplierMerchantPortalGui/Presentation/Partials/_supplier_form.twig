{#
    Content of the create and edit drawers. The drawer's ajax form wraps it in its own <form> and
    posts it back to the controller, hence excludeFormTag.
#}
{% form_theme form '@ZedUi/Form/form-webcomponent-layout.twig' %}

{% block body %}
    <web-mp-edit-supplier cloak>
        {{ form_start(form, { attr: { excludeFormTag: true } }) }}
            <h3 title>
                {{ (form.vars.data.idSupplier ? 'Edit Supplier' : 'Create Supplier') | trans }}
            </h3>

            <web-spy-card cloak spy-title="{{ 'Supplier Details' | trans }}">
                {{ form_row(form.name) }}
                {{ form_row(form.description) }}
            </web-spy-card>

            <web-spy-card cloak spy-title="{{ 'Contact Information' | trans }}">
                {{ form_row(form.email) }}
                {{ form_row(form.phone) }}
            </web-spy-card>

            <web-spy-card cloak spy-title="{{ 'Status' | trans }}">
                {{ form_row(form.isActive) }}
            </web-spy-card>

            {% block locations %}{% endblock %}

            <web-spy-button cloak action type="submit" size="lg">
                {{ 'Save' | trans }}
            </web-spy-button>
        {{ form_end(form) }}
    </web-mp-edit-supplier>
{% endblock %}
